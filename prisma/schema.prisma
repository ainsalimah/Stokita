generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
  CARD
}

enum MovementType {
  IN
  ADJUSTMENT
  SALE
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
}

model Store {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  isDemo Boolean @default(false)
  demoExpiresAt DateTime?
  users User[]
  branches Branch[]
  inventories BranchInventory[]
  products Product[]
  orders Order[]
  transfers StockTransfer[]
  returns SalesReturn[]
  movements StockMovement[]
  auditLogs AuditLog[]
  @@index([isDemo, demoExpiresAt])
}

model Branch {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id])
  code String
  name String
  address String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  users User[]
  sessions Session[]
  inventories BranchInventory[]
  orders Order[]
  outgoingTransfers StockTransfer[] @relation("TransferFrom")
  incomingTransfers StockTransfer[] @relation("TransferTo")
  returns SalesReturn[]
  movements StockMovement[]
  auditLogs AuditLog[]
  @@unique([storeId, code])
  @@index([storeId, active])
}

model BranchInventory {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id])
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  stock Int @default(0)
  @@unique([branchId, productId])
  @@index([storeId, branchId])
}

model User {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id])
  name String
  email String @unique
  passwordHash String
  role Role
  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id])
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sessions Session[]
  movements StockMovement[]
  auditLogs AuditLog[]
  createdTransfers StockTransfer[] @relation("TransferCreatedBy")
  receivedTransfers StockTransfer[] @relation("TransferReceivedBy")
  returns SalesReturn[]
  @@index([storeId])
  @@index([branchId])
}

model Session {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  activeBranchId String?
  activeBranch Branch? @relation(fields: [activeBranchId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

model Product {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id])
  sku String
  name String
  category String?
  price Int
  minStock Int @default(5)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  movements StockMovement[]
  inventories BranchInventory[]
  transferItems StockTransferItem[]
  returnItems SalesReturnItem[]
  @@unique([storeId, sku])
  @@index([storeId, name])
}

model Order {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id])
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  number String
  customerName String
  status OrderStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod?
  paidAt DateTime?
  refundedAt DateTime?
  refundedTotal Int @default(0)
  total Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  movements StockMovement[]
  returns SalesReturn[]
  @@unique([storeId, number])
  @@index([storeId, status, createdAt])
  @@index([branchId, status, createdAt])
  @@index([branchId, paymentStatus, createdAt])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Int
  unitPrice Int
  @@unique([orderId, productId])
}

model StockMovement {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id])
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  orderId String?
  order Order? @relation(fields: [orderId], references: [id])
  transferId String?
  transfer StockTransfer? @relation(fields: [transferId], references: [id])
  salesReturnId String?
  salesReturn SalesReturn? @relation(fields: [salesReturnId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  type MovementType
  quantity Int
  balanceAfter Int
  reason String
  createdAt DateTime @default(now())
  @@index([storeId, createdAt])
  @@index([branchId, createdAt])
  @@index([transferId])
  @@index([salesReturnId])
}

model StockTransfer {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id])
  number String
  fromBranchId String
  fromBranch Branch @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId String
  toBranch Branch @relation("TransferTo", fields: [toBranchId], references: [id])
  createdById String
  createdBy User @relation("TransferCreatedBy", fields: [createdById], references: [id])
  receivedById String?
  receivedBy User? @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  status TransferStatus @default(DRAFT)
  note String?
  createdAt DateTime @default(now())
  sentAt DateTime?
  receivedAt DateTime?
  items StockTransferItem[]
  movements StockMovement[]
  @@unique([storeId, number])
  @@index([storeId, createdAt])
  @@index([fromBranchId, status, createdAt])
  @@index([toBranchId, status, createdAt])
}

model StockTransferItem {
  id String @id @default(cuid())
  transferId String
  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Int
  @@unique([transferId, productId])
}

model SalesReturn {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id])
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id])
  number String
  total Int
  reason String
  createdAt DateTime @default(now())
  items SalesReturnItem[]
  movements StockMovement[]
  @@unique([storeId, number])
  @@index([orderId, createdAt])
  @@index([branchId, createdAt])
}

model SalesReturnItem {
  id String @id @default(cuid())
  salesReturnId String
  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Int
  unitPrice Int
  @@unique([salesReturnId, productId])
}

model AuditLog {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id])
  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  action String
  entity String
  entityId String
  createdAt DateTime @default(now())
  @@index([storeId, createdAt])
  @@index([branchId, createdAt])
}
